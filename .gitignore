# spike scratch: cloned upstream worker, built binaries, logs
spike/*/.work/

# local env. May contain tokens. .env matches every directory; deploy/.env
# is listed so the compose file is obvious.
.env
deploy/.env

# build output
/bin/
*.test

# stray go build output at repo root
/m0-spike

# static binary copied into the sidecar build context
harness/generic-openai/factory-harness

# Session trails and captured command logs. CI re-runs the checks.
.audit/

# console dependencies and Vite output. The embed copy is produced by
# `npm run build` and must not be committed.
web/console/node_modules/
web/console/dist/
internal/console/dist/
