root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 8

[*.sh]
indent_style = space
indent_size = 2
switch_case_indent = true

[*.bash]
indent_style = space
indent_size = 2
switch_case_indent = true

[*.yml]
indent_style = space
indent_size = 2

[*.yaml]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
