{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.internal/api/v1/factory-files/schemas/v1alpha1/factory.schema.json",
  "title": "Factory",
  "description": "factory.yaml for schemaVersion v1alpha1. Unknown keys are rejected. Markdown frontmatter resources (agent.md, automation.md, scorer.md, SKILL.md) are validated offline (layer 2), not by JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name"],
  "properties": {
    "schemaVersion": {
      "const": "v1alpha1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "alias": {
      "type": "string"
    },
    "codeForges": {
      "$ref": "#/$defs/stringList"
    },
    "repositories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "credentialStrategy": {
      "$ref": "#/$defs/credentialStrategy"
    },
    "integrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/integration"
      }
    },
    "secrets": {
      "$ref": "#/$defs/stringList"
    },
    "mcpServers": {
      "$ref": "#/$defs/mcpMap"
    },
    "agentDefaults": {
      "$ref": "#/$defs/agentSettings"
    },
    "inference": {
      "$ref": "#/$defs/inference"
    },
    "pipeline": {
      "$ref": "#/$defs/pipeline"
    },
    "selfImprovement": {
      "$ref": "#/$defs/selfImprovement"
    },
    "scorerDefaults": {
      "$ref": "#/$defs/scorerDefaults"
    },
    "benchmarkRepoSubstitutions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/benchmarkSubstitution"
      }
    },
    "cloudProviders": {
      "$ref": "#/$defs/cloudProviders"
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "credentialStrategy": {
      "enum": ["EXECUTOR", "CREATOR"]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name"],
      "properties": {
        "codeForge": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "deferred": {
          "type": "boolean"
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "slack": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "autoRespondToThreadReplies": {
              "type": "boolean"
            },
            "allowedUserIds": {
              "description": "Slack user ids permitted to continue work by replying in a factory thread. Empty or absent denies every Slack user (fail-closed).",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "linear": {
          "type": "object"
        },
        "jira": {
          "type": "object"
        }
      }
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warpId": {
          "type": ["string", "null"]
        },
        "managedId": {
          "type": "string"
        }
      }
    },
    "mcpMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/mcpServer"
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string"
            },
            "secretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "modelXorHarness": {
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["model"]
          },
          "then": {
            "not": {
              "required": ["harness"]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["harness"]
          },
          "then": {
            "not": {
              "required": ["model"]
            }
          }
        }
      ]
    },
    "agentSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "$ref": "#/$defs/harness"
        },
        "runner": {
          "type": "string"
        },
        "pool": {
          "type": "string"
        },
        "computerUseModel": {
          "type": "string"
        },
        "secrets": {
          "$ref": "#/$defs/stringList"
        },
        "mcpServers": {
          "$ref": "#/$defs/mcpMap"
        },
        "workerHost": {
          "type": "string"
        },
        "credentialStrategy": {
          "$ref": "#/$defs/credentialStrategy"
        },
        "idleTimeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 1
        },
        "required_repos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repository"
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/modelXorHarness"
        }
      ]
    },
    "inferenceProvider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "credentialRef": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "roleArn": {
          "type": "string"
        },
        "baseUrl": {
          "type": "string"
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string"
            },
            "credentialRef": {
              "type": "string"
            }
          }
        },
        "providers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/inferenceProvider"
          }
        }
      }
    },
    "approvalGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "approvers": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stages", "agents"],
      "properties": {
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "agents": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "skip": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "approvals": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/approvalGate"
          }
        },
        "revisionLimit": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "selfImprovement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failedRunThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "staleFailureDays": {
          "type": "integer",
          "minimum": 1
        },
        "reviewerType": {
          "enum": ["admins", "team", "custom", "none"]
        },
        "reviewerEmails": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scorerDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runner": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "secrets": {
          "$ref": "#/$defs/stringList"
        },
        "mcpServers": {
          "$ref": "#/$defs/mcpMap"
        }
      }
    },
    "benchmarkSubstitution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": {
          "$ref": "#/$defs/repository"
        },
        "target": {
          "$ref": "#/$defs/repository"
        }
      }
    },
    "cloudProviders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roleArn": {
              "type": "string"
            }
          }
        },
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projectNumber": {
              "type": "string"
            },
            "workloadIdentityFederationPoolId": {
              "type": "string"
            },
            "workloadIdentityFederationProviderId": {
              "type": "string"
            },
            "serviceAccountEmail": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
