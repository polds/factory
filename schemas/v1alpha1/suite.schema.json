{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.internal/api/v1/factory-files/schemas/v1alpha1/suite.schema.json",
  "title": "Benchmark suite",
  "description": "benchmarks/<suite>/suite.yaml. 1-6 configurations. definitionRef, when set, is a git ref name or a 40-hex SHA in the factory definition repo. Unknown keys are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "agent", "configurations", "tasks"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/configuration"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "agents"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "definitionRef": {
          "type": "string",
          "minLength": 1,
          "description": "Git ref name (check-ref-format, one level allowed) or 40-hex SHA. The loader syntax-checks it. T63 resolves it to a SHA per run."
        },
        "agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/binding"
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent"],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "$ref": "#/$defs/harness"
        }
      },
      "oneOf": [
        {
          "required": ["model"],
          "not": {
            "required": ["harness"]
          }
        },
        {
          "required": ["harness"],
          "not": {
            "required": ["model"]
          }
        }
      ]
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "model"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "secretName"],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "secretName": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
