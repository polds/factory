# Copy to deploy/.env. Leave values empty here; compose substitutes its
# dev defaults when a variable is unset. Do not put real tokens in this file.
# spike/m2/run.sh reads deploy/.env when the file exists. A non-empty shell
# variable wins over this file. Empty values here are ignored, and values
# are not executed.

# Postgres role password. Compose default: factory
POSTGRES_PASSWORD=

# MinIO root user (>= 3 characters) and password (>= 8 characters).
# Compose defaults: factoryadmin / factorysecret
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Control-plane and worker bearers. Compose defaults are local placeholders.
FACTORY_API_KEY=
FACTORY_WORKER_API_KEY=

# Host port factoryd binds inside the container. Compose default: :8080
FACTORY_HTTP_ADDR=

# Browser-facing base URL. Compose default: http://localhost:8080
FACTORY_EXTERNAL_URL=

# Base URL task containers use to reach factoryd. They are on the host
# Docker bridge, not the compose network. Compose default (Linux):
# http://172.17.0.1:8080
# Docker Desktop: http://host.docker.internal:8080
FACTORY_TASK_SERVER_URL=

# Host path of the definition tree mounted into factoryd.
# Compose default: ./m2-factory (relative to this directory).
FACTORY_DEFINITION_HOST_PATH=

# Object store. The endpoint inside compose is http://minio:9000.
FACTORY_S3_REGION=

# Scheduler identity for every connected worker. Defaults: standard / linux / 1
FACTORY_WORKER_POOL=
FACTORY_WORKER_PLATFORM=
FACTORY_WORKER_MAX_CONCURRENT=

FACTORY_LOG_LEVEL=

# Copied into task env as OPENAI_BASE_URL and OPENAI_API_KEY.
# Offline: spike/m2/run.sh points the base URL at the model stub on the
# docker bridge gateway. Live: set these from OPENAI_BASE_URL / OPENAI_API_KEY.
FACTORY_INFERENCE_OPENAI_COMPATIBLE_BASE_URL=
FACTORY_INFERENCE_OPENAI_API_KEY=

# Allowlisted by deploy/m2-factory (secrets: [GH_TOKEN]). Never commit a token.
FACTORY_SECRET_GH_TOKEN=

# Shell names for spike/m2/run.sh MODE=live. The FACTORY_SECRET_GH_TOKEN and
# FACTORY_INFERENCE_* variables above are the same values. Compose does not
# interpolate the names in this block.
OPENAI_BASE_URL=
OPENAI_API_KEY=
M2_MODEL=
M2_REPO=
GH_TOKEN=

# spike/m3/run.sh reads this file too. Compose does not interpolate the
# names below. Offline uses the model ids in deploy/m3-factory. Live
# requires four distinct model ids. APPROVAL_DECISION=approve is the only
# value that lets the script decide the spec gate. Leave it empty to print
# the approval id and wait. Docker Desktop: set FACTORY_TASK_SERVER_URL to
# http://host.docker.internal:8080 and put that host in OPENAI_BASE_URL.
# spike/m3/run.sh does not rewrite a loopback model URL.
M3_REPO=
M3_MODEL_TRIAGE=
M3_MODEL_PLANNING=
M3_MODEL_BUILDING=
M3_MODEL_REVIEWING=
APPROVAL_DECISION=

# M4 ingress, outbound, and run tokens. Empty values leave that integration off.
# Do not put real tokens in this file.
FACTORY_GITHUB_APP_ID=
FACTORY_GITHUB_APP_PRIVATE_KEY_FILE=
FACTORY_GITHUB_WEBHOOK_SECRET=
# app mints a scoped installation token at assignment when GH_TOKEN is allowlisted.
# pat (default) copies FACTORY_SECRET_GH_TOKEN.
FACTORY_GITHUB_TOKEN_MODE=
FACTORY_SLACK_BOT_TOKEN=
FACTORY_SLACK_SIGNING_SECRET=
# Slack team id for slack:<team>/<channel>/<root ts>. The definition has a channel and no team.
FACTORY_SLACK_TEAM_ID=
FACTORY_LINEAR_API_KEY=
FACTORY_LINEAR_WEBHOOK_SECRET=
# Default 168h. Unmatched deliveries are still shortened to 72h by the store.
FACTORY_DELIVERY_RETENTION=
# Default 1h.
FACTORY_SCHEDULE_CATCHUP=
# Optional API bases for a fake or a GitHub Enterprise host.
# FACTORY_GITHUB_API_BASE=
# FACTORY_SLACK_API_BASE=
# FACTORY_LINEAR_API_BASE=

# spike/m4/run.sh reads this file too. Compose does not interpolate the
# names below. Offline replaces provider secrets with local fakes. Live
# keeps the FACTORY_GITHUB_* and FACTORY_SLACK_* values above. From a
# container, the model server is http://host.docker.internal:8317/v1
# (FACTORY_INFERENCE_OPENAI_COMPATIBLE_BASE_URL). The host catalog probe
# uses 127.0.0.1 on that port. The App private key
# stays at spike/m4/secrets/github-app.pem. spike/m4/.gitignore ignores
# secrets/. The script copies the key to spike/m4/.work/live/github-app.pem
# (mode 644) and mounts the copy. Do not commit the key or this file's copy.
FACTORY_PUBLIC_URL=
M4_REPO=
M4_SLACK_CHANNEL=
M4_SLACK_ALLOWED_USER=
# Required for MODE=live and MODE=live-ci. Replaces m4-triage, m4-planning,
# m4-building, and m4-reviewing in the mounted copy. Each override below is
# optional; an empty value uses M4_LIVE_MODEL.
M4_LIVE_MODEL=
M4_LIVE_MODEL_TRIAGE=
M4_LIVE_MODEL_PLANNING=
M4_LIVE_MODEL_BUILDING=
M4_LIVE_MODEL_REVIEWING=
# Optional. When both are set, MODE=live posts the reply as that Slack user.
SLACK_TEST_USER_TOKEN=
REPLY_TEXT=
# M5 console. on serves the embedded console (the default when unset).
# off serves the API catch-all and leaves run links on the API.
# Any other value fails startup and names FACTORY_CONSOLE.
FACTORY_CONSOLE=on
