+
+// taskExtraHostsFromEnv is passed to every task container as Docker extra_hosts.
+// FACTORY_TASK_EXTRA_HOSTS is a comma-separated list of host:ip entries.
+// host.docker.internal:host-gateway is the entry a Linux daemon needs when the
+// name is not already in the container resolver. An empty value adds nothing.
+func taskExtraHostsFromEnv() []string {
+	raw := strings.TrimSpace(os.Getenv("FACTORY_TASK_EXTRA_HOSTS"))
+	if raw == "" {
+		return nil
+	}
+	var hosts []string
+	for _, part := range strings.Split(raw, ",") {
+		part = strings.TrimSpace(part)
+		if part != "" {
+			hosts = append(hosts, part)
+		}
+	}
+	return hosts
+}
