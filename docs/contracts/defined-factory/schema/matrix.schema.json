{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.internal/contracts/defined-factory/matrix.schema.json",
  "title": "Producer consumer matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "baseline", "rows"],
  "properties": {
    "contractVersion": {"const": "defined-factory/1"},
    "baseline": {"const": "85812997d8e81b0209b678e583a7738b9d066966"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invariant",
          "title",
          "consumer",
          "producer",
          "method",
          "fieldPath",
          "baseline",
          "decision",
          "testOwner",
          "positive",
          "negative"
        ],
        "properties": {
          "invariant": {"type": "string", "pattern": "^INV-[A-Z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "consumer": {"type": "string", "minLength": 1},
          "producer": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "fieldPath": {"type": "string", "minLength": 1},
          "baseline": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "start", "end", "anchor"],
            "properties": {
              "file": {"type": "string", "minLength": 1},
              "start": {"type": "integer", "minimum": 1},
              "end": {"type": "integer", "minimum": 1},
              "anchor": {"type": "string", "minLength": 1}
            }
          },
          "decision": {"type": "string", "minLength": 1},
          "testOwner": {"type": "string", "minLength": 1},
          "positive": {"type": "string", "minLength": 1},
          "negative": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
